# ── Confluent Cloud ──────────────────────────────────────────────────────────
# Kafka cluster ID and bootstrap server
# Find: Confluent Cloud → your cluster → Cluster overview → Cluster settings → Bootstrap server
BOOTSTRAP_SERVERS=REPLACE_WITH_BOOTSTRAP_SERVER

# Confluent environment ID (env-XXXXXX)
# Find: Confluent Cloud → Environments → click your environment → Details panel (right side)
CONFLUENT_ENVIRONMENT_ID=REPLACE_WITH_ENV_ID

# Kafka cluster-scoped API key (used by simulator + dashboard for broker SASL auth)
# Create under: Confluent Cloud → your cluster → API keys → + Add key → This cluster
KAFKA_API_KEY=REPLACE_WITH_CLUSTER_API_KEY
KAFKA_API_SECRET=REPLACE_WITH_CLUSTER_API_SECRET
# Find: Confluent Cloud → your cluster → Cluster overview → Cluster settings → REST endpoint
KAFKA_REST_ENDPOINT=REPLACE_WITH_REST_ENDPOINT
# Find: Confluent Cloud → your cluster → Cluster overview → Cluster settings → Cluster ID (lkc-XXXXX)
KAFKA_CLUSTER_ID=REPLACE_WITH_CLUSTER_ID
KAFKA_ENV_ID=REPLACE_WITH_ENV_ID

# Schema Registry
# Find: Confluent Cloud → your environment → Schema Registry → Endpoints → Public endpoint
SCHEMA_REGISTRY_URL=REPLACE_WITH_SCHEMA_REGISTRY_URL
# Create under: Confluent Cloud → your environment → Schema Registry → API keys → + Add key
SCHEMA_REGISTRY_API_KEY=REPLACE_WITH_SCHEMA_REGISTRY_API_KEY
SCHEMA_REGISTRY_API_SECRET=REPLACE_WITH_SCHEMA_REGISTRY_API_SECRET

# Confluent Cloud global API key (used by MCP server + Flink REST API)
# Create under: Confluent Cloud → user avatar (top-right) → Cloud API keys → + Add key → Global access
# Note: FLINK_API_KEY and FLINK_API_SECRET below use the same global key
CONFLUENT_CLOUD_API_KEY=REPLACE_WITH_GLOBAL_API_KEY
CONFLUENT_CLOUD_API_SECRET=REPLACE_WITH_GLOBAL_API_SECRET
CONFLUENT_CLOUD_REST_ENDPOINT=https://api.confluent.cloud

# ── Confluent Flink ──────────────────────────────────────────────────────────
# Find: Confluent Cloud → your environment → Flink → Compute pools → click your pool → pool ID (lfcp-XXXXX)
FLINK_COMPUTE_POOL_ID=REPLACE_WITH_COMPUTE_POOL_ID
# Region-specific endpoint — replace <region> with your cluster region (e.g. us-east-2)
FLINK_REST_ENDPOINT=https://flink.REPLACE_WITH_REGION.aws.confluent.cloud
# Find: Confluent Cloud → user avatar (top-right) → Organization settings → Organization ID
FLINK_ORG_ID=REPLACE_WITH_ORG_ID
# Same global API key as CONFLUENT_CLOUD_API_KEY above
FLINK_API_KEY=REPLACE_WITH_GLOBAL_API_KEY
FLINK_API_SECRET=REPLACE_WITH_GLOBAL_API_SECRET
FLINK_ENV_ID=REPLACE_WITH_ENV_ID
# The human-readable name of your Confluent Cloud environment (not the ID)
FLINK_CATALOG_NAME=REPLACE_WITH_ENVIRONMENT_NAME
# The name of your Kafka cluster within that environment (e.g. cluster-gcc)
FLINK_DATABASE_NAME=REPLACE_WITH_CLUSTER_NAME


# ── Confluent TableFlow (Iceberg) ─────────────────────────────────────────────
# Leave blank to run without historical Iceberg queries (graceful degradation)
# Find: Confluent Cloud → your environment → TableFlow → click your connector → Catalog URI
TABLEFLOW_CATALOG_URI=REPLACE_WITH_TABLEFLOW_CATALOG_URI
# Find: Confluent Cloud → your environment → TableFlow → click your connector → Warehouse location
TABLEFLOW_WAREHOUSE=REPLACE_WITH_TABLEFLOW_WAREHOUSE
# Same as KAFKA_CLUSTER_ID (lkc-XXXXXXX)
TABLEFLOW_NAMESPACE=REPLACE_WITH_CLUSTER_ID
# Same global API key as CONFLUENT_CLOUD_API_KEY above
TABLEFLOW_API_KEY=REPLACE_WITH_GLOBAL_API_KEY
TABLEFLOW_API_SECRET=REPLACE_WITH_GLOBAL_API_SECRET

# ── watsonx Orchestrate ──────────────────────────────────────────────────────
# Find: IBM Cloud → your watsonx Orchestrate instance → Manage → Instance URL
WO_INSTANCE=REPLACE_WITH_WXO_INSTANCE_URL
# Create under: IBM Cloud → user avatar (top-right) → IBM Cloud API keys → Create an IBM Cloud API key
WO_API_KEY=REPLACE_WITH_IBM_CLOUD_API_KEY

# Agent IDs — added after the agent is deployed in Lab 2
WO_TRIAGE_AGENT_ID=
