# ── Confluent Cloud ──────────────────────────────────────────────────────────
# Kafka cluster bootstrap server (found under: Cluster → Cluster Settings)
BOOTSTRAP_SERVERS=<your-cluster>.aws.confluent.cloud:9092

# Kafka cluster-scoped API key and secret
# Create under: Confluent Cloud → your cluster → API keys → Add key
KAFKA_API_KEY=<your-kafka-api-key>
KAFKA_API_SECRET=<your-kafka-api-secret>

# Schema Registry URL and API key
# Found under: Confluent Cloud → your environment → Schema Registry
SCHEMA_REGISTRY_ENDPOINT=https://<your-schema-registry>.aws.confluent.cloud
SCHEMA_REGISTRY_API_KEY=<your-sr-api-key>
SCHEMA_REGISTRY_API_SECRET=<your-sr-api-secret>
