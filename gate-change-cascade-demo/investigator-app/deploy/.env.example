# investigator-app/deploy/.env.example
#
# Copy to .env and fill in before running code-engine-deploy.sh.
# Confluent credentials (CONFLUENT_BOOTSTRAP_SERVERS, KAFKA_API_KEY,
# KAFKA_API_SECRET) are read automatically from gate-change-cascade/.env —
# no need to duplicate them here.

# ---------------------------------------------------------------------------
# IBM Cloud / Code Engine  (required)
# ---------------------------------------------------------------------------
# WO_API_KEY is used for IBM Cloud login AND as the ICR registry secret
# password (username "iamapikey" is standard for IBM Cloud Container Registry).
WO_API_KEY=

# TechZone resource group name (e.g. the environment ID from your reservation)
RESOURCE_GROUP=

# IBM Cloud region where your Code Engine project lives.
# The deploy script maps this to the correct ICR hostname automatically:
#   us-south → us.icr.io  |  ca-tor → ca.icr.io  |  eu-de → de.icr.io
#   eu-gb    → uk.icr.io  |  au-syd → au.icr.io  |  jp-tok → jp.icr.io
REGION=ca-tor

# ---------------------------------------------------------------------------
# IBM Cloud Container Registry  (optional)
# ---------------------------------------------------------------------------
# The ICR namespace to push the image into.
# Defaults to 'gcc-investigator' — the script creates it automatically if it
# doesn't exist. Override only if you want to use a different namespace.
# ICR_NAMESPACE=gcc-investigator

# ---------------------------------------------------------------------------
# Defaults — override only if your environment differs
# ---------------------------------------------------------------------------
# CE_PROJECT_NAME=ce-${RESOURCE_GROUP}
# CE_APP_NAME=gcc-investigator
# REGISTRY_SECRET_NAME=gcc-icr-secret

# Container runtime — defaults to podman, falls back to docker if not found.
# Override to force one or the other:
# DOCKER=podman
# DOCKER=docker

# ---------------------------------------------------------------------------
# Populated automatically by code-engine-deploy.sh — do not edit manually
# ---------------------------------------------------------------------------
INVESTIGATOR_API_URL=
