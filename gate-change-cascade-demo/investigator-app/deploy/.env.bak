# investigator-app/deploy/.env.example
#
# Copy to .env and fill in before running code-engine-deploy.sh.
# Confluent credentials (CONFLUENT_BOOTSTRAP_SERVERS, KAFKA_API_KEY,
# KAFKA_API_SECRET) are read automatically from gate-change-cascade/.env —
# no need to duplicate them here.

# ---------------------------------------------------------------------------
# IBM Cloud / Code Engine  (required)
# ---------------------------------------------------------------------------
# WO_API_KEY doubles as the IBM Cloud login key and the IAM key for
# pushing images to IBM Container Registry.
WO_API_KEY=mZfoKt3mD1lPkK6Aua3dm1p2ju3E9_s9Ns2H3X6ArcgW

# TechZone resource group name (e.g. the environment ID from your reservation)
RESOURCE_GROUP=itz-wxo-6aac5b7093bf59c1019956

# IBM Cloud region where your Code Engine project lives
REGION=ca-tor

# ---------------------------------------------------------------------------
# Defaults — override only if your environment differs
# ---------------------------------------------------------------------------
# IMAGE_REGISTRY=us.icr.io
# CE_PROJECT_NAME=ce-${RESOURCE_GROUP}
# REGISTRY_SECRET_NAME=gcc-cr-secret
# SSH_SECRET_NAME=gcc-ghe-ssh-secret

# Repo to build from. Default points to the IBM internal GitHub (github.ibm.com).
# If using a public github.com fork, change to the SSH URL of your fork:
# GITHUB_REPO=git@github.ibm.com:skol/confluent-client-bootcamp.git
# GITHUB_REPO=git@github.com:your-org/confluent-client-bootcamp.git
BRANCH_NAME=ann-gate-change-cascade

# Path to your SSH private key for cloning the private IBM GitHub repo.
# Auto-detected from ~/.ssh/id_ed25519 or ~/.ssh/id_rsa if left unset.
# PRIVATE_KEY_PATH=~/.ssh/id_ed25519

# ---------------------------------------------------------------------------
# Populated automatically by code-engine-deploy.sh — do not edit manually
# ---------------------------------------------------------------------------
INVESTIGATOR_API_URL=
