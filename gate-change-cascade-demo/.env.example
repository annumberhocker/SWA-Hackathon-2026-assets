# ── Confluent Cloud ──────────────────────────────────────────────────────────
# Kafka cluster ID and bootstrap server. Env -> clusters -> <your created cluster> -> Overview
CONFLUENT_CLUSTER_ID=
CONFLUENT_BOOTSTRAP_SERVERS=

# Confluent environment ID (env-XXXXXX). Home -> Environments -> <your environment> -> Details
CONFLUENT_ENVIRONMENT_ID=

# Schema Registry -
# Schema Registry -> Overview -> Public Endpoint
CONFLUENT_SCHEMA_REGISTRY_URL=
Schema Registry -> Overview -> API keys -> Add API key
CONFLUENT_SR_API_KEY=
CONFLUENT_SR_API_SECRET=

# Kafka cluster-scoped API key (used by simulator + dashboard for broker SASL auth)
# Create under: Confluent Cloud → <your cluster> → API keys → Add key
KAFKA_API_KEY=
KAFKA_API_SECRET=

# Confluent Cloud global API key (used by MCP server + Flink REST API)
# Create under: Confluent Cloud → Admin & Security → API keys → Add key (Global scope)
CONFLUENT_API_KEY=
CONFLUENT_API_SECRET=

# ── Confluent Flink ──────────────────────────────────────────────────────────
FLINK_COMPUTE_POOL_ID=
FLINK_REST_ENDPOINT=
FLINK_ORG_ID=

# ── Confluent TableFlow (Iceberg) ─────────────────────────────────────────────
# Leave blank to run without historical Iceberg queries (graceful degradation)
TABLEFLOW_CATALOG_URI=
TABLEFLOW_WAREHOUSE=
TABLEFLOW_NAMESPACE=

# ── watsonx Orchestrate ──────────────────────────────────────────────────────
WO_INSTANCE=https://api.us-south.watson-orchestrate.cloud.ibm.com/instances/your-instance-id
WO_API_KEY=

# Agent IDs — written automatically by orchestrate/bootstrap_env.sh
WO_SUPERVISOR_AGENT_ID=
WO_TRIAGE_AGENT_ID=
WO_SLACK_AGENT_ID=
WO_SNOW_AGENT_ID=
WO_GMAIL_AGENT_ID=

# ── Investigator API (instructor-deployed, optional for dry runs) ─────────────
# Leave blank to fall back to local file logging at /tmp/gcc_agent_activity.log
INVESTIGATOR_API_URL=

# ── ServiceNow ───────────────────────────────────────────────────────────────
# PDI URL — also update orchestrate/connections/servicenow_connection.yaml with the same URL
SNOW_INSTANCE_URL=https://YOUR-PDI.service-now.com
# OAuth client — System OAuth → Application Registry → your app → Client ID / Client Secret
SNOW_CLIENT_ID=
SNOW_CLIENT_SECRET=
# Admin credentials (used as OAuth resource-owner password grant)
SNOW_USERNAME=admin
SNOW_PASSWORD=

# ── Slack ────────────────────────────────────────────────────────────────────
# OAuth app credentials — api.slack.com/apps → your app → Basic Information → App Credentials
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Channel ID — right-click channel in Slack → View channel details → Channel ID (starts with C)
SLACK_CHANNEL_ID=

# ── Gmail (optional) ─────────────────────────────────────────────────────────
# Google Cloud OAuth app credentials — console.cloud.google.com → APIs & Services → Credentials
# See docs/07-gmail-setup.md for full setup instructions
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Gmail address that will send anomaly notifications
GMAIL_SENDER_ADDRESS=
# Recipient address for anomaly alerts
GMAIL_RECIPIENT_ADDRESS=

# ── Simulator control ─────────────────────────────────────────────────────────
SIMULATOR_CONTROL_URL=http://localhost:8090

# ── Optional overrides (defaults are baked in) ───────────────────────────────
# SIMULATOR_AUTOSTART=1
# SIMULATOR_CONTROL_BIND=127.0.0.1
# SIMULATOR_CONTROL_PORT=8090
# AGENT_ACTIVITY_LOG=/tmp/gcc_agent_activity.log
# RESET=1
